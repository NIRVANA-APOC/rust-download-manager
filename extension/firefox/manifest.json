{
  "manifest_version": 3,
  "name": "RDM 下载接管",
  "short_name": "RDM",
  "version": "0.2.0",
  "description": "把 Firefox 下载交给 RDM 多线程下载器：自动接管、右键转交、解析页面资源、Cookie/Referer 透传、失败自动回退浏览器下载。",
  "icons": {
    "16": "icons/rdm-16.png",
    "32": "icons/rdm-32.png",
    "48": "icons/rdm-48.png",
    "96": "icons/rdm-96.png",
    "128": "icons/rdm-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@rdm.download",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "lib/pure.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "RDM 下载接管",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/rdm-16.png",
      "32": "icons/rdm-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
